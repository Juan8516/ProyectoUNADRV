--- !u!114 &1209892541
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1209892539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c0b6fe0286bfe2418476b301f5d5911, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  info: "El sistema \xF3seo es el conjunto de huesos que da soporte, forma y protecci\xF3n
    al cuerpo humano. Est\xE1 compuesto por 206 huesos unidos por articulaciones,
    ligamentos y cart\xEDlagos. Su funci\xF3n principal es sostener el cuerpo y permitir
    el movimiento junto con los m\xFAsculos. Tambi\xE9n protege \xF3rganos vitales
    como el cerebro, el coraz\xF3n y los pulmones. Adem\xE1s, almacena minerales
    como el calcio y produce c\xE9lulas sangu\xEDneas en la m\xE9dula \xF3sea. "
  infoPanel: {fileID: 1066520728}
  infoText: {fileID: 531739551}
  displayTime: 10
