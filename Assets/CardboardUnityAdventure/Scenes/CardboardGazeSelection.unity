  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c0b6fe0286bfe2418476b301f5d5911, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  info: "El sistema respiratorio es el encargado de realizar el intercambio de gases
    entre el cuerpo y el ambiente. Su funci\xF3n principal es captar ox\xEDgeno y
    eliminar di\xF3xido de carbono. Est\xE1 formado por la nariz, faringe, laringe,
    tr\xE1quea, bronquios y pulmones. Permite la respiraci\xF3n, esencial para obtener
    energ\xEDa en las c\xE9lulas. Adem\xE1s, ayuda a mantener el equilibrio \xE1cido-base
    del organismo."
  infoPanel: {fileID: 451028226}
  infoText: {fileID: 632182940}
  displayTime: 10
